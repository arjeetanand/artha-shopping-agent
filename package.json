{
  "name": "artha-purchase-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "./run.sh",
    "dev": "vite",
    "backend": "python3 backend/server.py",
    "test:e2e": "python3 tests/e2e_local.py",
    "test:brief": "python3 tests/brief_fallback.py",
    "test:payments": "python3 tests/payment_adapter.py",
    "test:auth": "python3 tests/auth_contract.py",
    "test:location": "python3 tests/location_adapter.py",
    "test:agentic": "python3 tests/qa_agentic_flow.py && python3 tests/retailer_contracts.py && python3 tests/refinement_trust.py && python3 tests/test_price_history.py",
    "test:voice": "node tests/voice_call.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.0",
    "vite": "latest"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
