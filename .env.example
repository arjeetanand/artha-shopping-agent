# Runtime mode. `auto` resolves to Ollama locally and Gemini in production.
APP_ENV=development
SHOPPINGHELP_HOST=127.0.0.1
SHOPPINGHELP_PORT=8000
SHOPPINGHELP_APP_URL=http://127.0.0.1:5173
SHOPPINGHELP_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
SHOPPINGHELP_COOKIE_SECURE=0

# Google OAuth web client. Register GOOGLE_REDIRECT_URI exactly in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Optional: register this separate callback in Google Cloud. If blank, Gmail reuses GOOGLE_REDIRECT_URI.
GOOGLE_GMAIL_REDIRECT_URI=
# Optional production geocoding and nearby-store context after the user grants browser location permission.
GOOGLE_MAPS_API_KEY=
# Set to 0 to keep Places calls disabled while retaining geocoding.
GOOGLE_MAPS_PLACES_ENABLED=1

# Search and extraction. Keys stay on the Python server.
# Tavily offers 1,000 free credits/month. Create a key at https://app.tavily.com
TAVILY_API_KEY=
# auto prefers Tavily when its key is present; otherwise Anakin. No paid-provider fallback.
SHOPPINGHELP_SEARCH_PROVIDER=auto
ANAKIN_API_KEY=
ANAKIN_BASE_URL=https://api.anakin.io/v1
# Set to `fixture` for deterministic local end-to-end tests. Keep `live` for the configured provider.
SHOPPINGHELP_SEARCH_MODE=live

# Development checkout is local-only. Production accepts `razorpay` only after server credentials are configured.
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# AI brief extraction. `auto` = Ollama in local development, Gemini in production.
AI_PROVIDER=auto
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional for local screenshot/reference-image analysis. Use an Ollama vision model, for example llama3.2-vision.
OLLAMA_VISION_MODEL=llama3.2-vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Taste memory uses Gemini embeddings when its key is set; otherwise Ollama.
# Optional overrides: TASTE_EMBEDDING_PROVIDER=ollama and TASTE_EMBEDDING_MODEL=nomic-embed-text.
# Retailer sessions and invoices default to the OS user-data directory, outside this repository.
# SHOPPINGHELP_PRIVATE_DIR=/absolute/private/local/directory

# Voice. Local development uses Kokoro when installed, with browser speech as a safe fallback.
# Production `auto` requires ElevenLabs instead of silently falling back to browser speech.
VOICE_PROVIDER=auto
LOCAL_VOICE_PROVIDER=kokoro
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.98
KOKORO_DEVICE=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# SLNG voice output: set VOICE_PROVIDER=slng and add the key, or run npm run demo:voice.
SLNG_API_KEY=
# Regional gateway; the former global api.slng.ai gateway is retired.
SLNG_API_BASE_URL=https://in.api.slng.ai
