# Blank uses the bundled local API at /api/gateway.
# Set this to the Make Custom Webhook URL when the scenarios are configured.
VITE_MAKE_GATEWAY_URL=

# Set to demo only to bypass the local/Make gateway and use in-browser state.
VITE_GATEWAY_MODE=

# Frontend never receives provider API keys. These remain Make connections.
# AI provider connection: {{AI_PROVIDER_CONNECTION}}
# Notifications: {{NOTIFICATION_CHANNEL}}
